# Copy to config.env and edit as needed:
#   cp config.env.example config.env

# Home Assistant dashboard URL (HACS Kiosk Mode must be installed on HA)
KIOSK_URL=https://home.whigham.me/?kiosk

# Official 7" Touch Display output name
DISPLAY_OUTPUT=DSI-1

# Rotation: normal | 90 | 180 | 270
# Use 90 or 270 when the panel is mounted in portrait / ribbon orientation requires it.
DISPLAY_ROTATION=normal

# Linux user that auto-logs in and runs the kiosk session.
# Leave empty to use the user who runs setup.sh.
KIOSK_USER=
